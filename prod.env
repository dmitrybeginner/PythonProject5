# ===================================================
#         Настройки Django для Production
# ===================================================

# ВАЖНО: В production среде DEBUG всегда должен быть False для безопасности.
DEBUG=False

# Секретный ключ Django. Обязательно замените на своё уникальное значение.
SECRET_KEY=prod_django_secret_key_@b2z(5-n&pf-!#v*m@c$@p&l@a#c$@p&l

# Список разрешенных хостов. '*' - разрешает все, но для безопасности лучше указаться конкретный домен.
# Например: ALLOWED_HOSTS=your_domain.com,www.your_domain.com
ALLOWED_HOSTS=*


# ===================================================
#              Настройки базы данных (PostgreSQL)
# ===================================================
# Эти переменные используются для подключения к контейнеру с PostgreSQL.
POSTGRES_DB=PythonProject5
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ProdSecureDBPassw0rd!2025
DB_HOST=db
DB_PORT=5432


# ===================================================
#                 Настройки Redis
# ===================================================
# Используется для Celery (фоновые задачи) и кеширования.
REDIS_HOST=redis
REDIS_PORT=6379


# ===================================================
#                 Настройки Stripe
# ===================================================
# Ключ для интеграции с платежной системой Stripe.
STRIPE_API_KEY=sk_live_...


# ===================================================
#            Настройки отправки почты (SMTP)
# ===================================================
# Данные для подключения к вашему почтовому серверу.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=password
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com